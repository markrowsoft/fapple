disable_legacy_auto_mount() {
  local uid plist
  uid="$(user_uid)"
  plist="$(legacy_user_plist_path)"
  if launchctl print "gui/${uid}/${LEGACY_LAUNCHD_LABEL}" >/dev/null 2>&1; then
    launchctl bootout "gui/${uid}/${LEGACY_LAUNCHD_LABEL}" 2>/dev/null || true
  fi
  if [[ -f "${plist}" ]]; then
    rm -f "${plist}"
    echo "removed legacy ${plist}"
  fi
  if launchctl print "system/${LEGACY_LAUNCHD_LABEL}" >/dev/null 2>&1; then
    launchctl bootout "system/${LEGACY_LAUNCHD_LABEL}" 2>/dev/null || true
  fi
  if [[ -f "/Library/LaunchDaemons/${LEGACY_LAUNCHD_LABEL}.plist" && ${EUID} -eq 0 ]]; then
    rm -f "/Library/LaunchDaemons/${LEGACY_LAUNCHD_LABEL}.plist"
    echo "removed legacy /Library/LaunchDaemons/${LEGACY_LAUNCHD_LABEL}.plist"
  fi
}

enable_auto_mount_daemon() {
  need_root "enable-auto-mount"
  ensure_hfs_image "${SYSTEM_IMAGE_PATH}" "${SYSTEM_VOLUME_NAME}"
  write_launchd_plist "${SYSTEM_LAUNCHD_PLIST}" "${SYSTEM_LAUNCHD_LABEL}" \
    "${SYSTEM_IMAGE_PATH}" "${SYSTEM_MOUNT}"
  if auto_mount_loaded_system_label "${SYSTEM_LAUNCHD_LABEL}"; then
    launchctl bootout "system/${SYSTEM_LAUNCHD_LABEL}" 2>/dev/null || true
  fi
  if auto_mount_loaded_system_label "${LAUNCHD_LABEL}"; then
    launchctl bootout "system/${LAUNCHD_LABEL}" 2>/dev/null || true
  fi
  if [[ -f "${LAUNCHD_PLIST}" ]]; then
    rm -f "${LAUNCHD_PLIST}"
  fi
  launchctl bootstrap system "${SYSTEM_LAUNCHD_PLIST}"
  launchctl enable "system/${SYSTEM_LAUNCHD_LABEL}" >/dev/null 2>&1 || true
  echo "enabled auto-mount at boot: ${SYSTEM_LAUNCHD_PLIST}"
  echo "  image:       ${SYSTEM_IMAGE_PATH}"
  echo "  mount point: ${SYSTEM_MOUNT}"
}

enable_auto_mount_agent() {
  local dest src plist uid
  dest="$(user_image_path)"
  plist="$(user_plist_path)"
  uid="$(user_uid)"
  MOUNT_POINT="$(default_mount_point)"
  resolve_image_path
  src=""
  if [[ -r "${IMAGE_PATH}" ]]; then
    src="${IMAGE_PATH}"
  fi
  mkdir -p "$(dirname "${dest}")"
  chflags nouchg "${dest}" 2>/dev/null || true
  if [[ ! -f "${dest}" ]]; then
    [[ -n "${src}" ]] || die "no 1 MB disk at ${IMAGE_PATH} or ${dest}; run: sudo $0 create"
    cp -p "${src}" "${dest}"
    echo "copied image to ${dest}"
  else
    echo "using existing user image ${dest}"
  fi
  IMAGE_PATH="${dest}"
  harden_image_file

  write_user_launchd_plist "${plist}"
  if auto_mount_loaded_user; then
    launchctl bootout "gui/${uid}/${LAUNCHD_LABEL}" 2>/dev/null || true
  fi
  launchctl bootstrap "gui/${uid}" "${plist}"
  launchctl enable "gui/${uid}/${LAUNCHD_LABEL}" >/dev/null 2>&1 || true
  disable_legacy_auto_mount
  echo "enabled auto-mount at login: ${plist}"
  echo "  image:       ${dest}"
  echo "  mount point: ${MOUNT_POINT}"
}

enable_auto_mount() {
  if [[ "${MODE}" != "image" ]]; then
    die "auto-mount is only implemented for the disk-image mode"
  fi
  if [[ ${EUID} -eq 0 ]]; then
    enable_auto_mount_daemon
    enable_auto_mount_agent
  else
    enable_auto_mount_agent
  fi
  disable_legacy_auto_mount
}

disable_auto_mount_daemon() {
  local label
  for label in "${SYSTEM_LAUNCHD_LABEL}" "${LAUNCHD_LABEL}"; do
    if auto_mount_loaded_system_label "${label}"; then
      launchctl bootout "system/${label}" 2>/dev/null || true
    fi
  done
  for f in "${SYSTEM_LAUNCHD_PLIST}" "${LAUNCHD_PLIST}"; do
    if [[ -f "${f}" ]]; then
      rm -f "${f}"
      echo "removed ${f}"
    fi
  done
}

disable_auto_mount_agent() {
  local plist uid
  plist="$(user_plist_path)"
  uid="$(user_uid)"
  if auto_mount_loaded_user; then
    launchctl bootout "gui/${uid}/${LAUNCHD_LABEL}" 2>/dev/null || true
  fi
  if [[ -f "${plist}" ]]; then
    rm -f "${plist}"
    echo "removed ${plist}"
  fi
}

disable_auto_mount() {
  if [[ ${EUID} -eq 0 ]]; then
    disable_auto_mount_daemon
    disable_auto_mount_agent
  else
    disable_auto_mount_agent
  fi
  disable_legacy_auto_mount
  echo "disabled auto-mount"
}

fapple_is_installed() {
  [[ -x "${INSTALL_PATH}" ]]
}

# Copy this script to INSTALL_PATH when dest is writable. Returns 0 if
# dest already matches src or the copy succeeded; 1 if dest could not
# be written. Does not occupy Trial or touch launchd.
update_installed_copy() {
  local src dest
  src="$(script_self)"
  dest="${INSTALL_PATH}"
  if [[ -x "${dest}" ]] && cmp -s "${src}" "${dest}" 2>/dev/null; then
    return 0
  fi
  [[ "${src}" != "${dest}" ]] || return 0
  mkdir -p "$(dirname "${dest}")" 2>/dev/null || true
  if install -m 0755 "${src}" "${dest}" 2>/dev/null; then
    echo "installed ${dest}"
    return 0
  fi
  return 1
}

# Copy the binary if dest is writable, occupy Trial dirs, and enable
# auto-mount. sudo occupies both ~/Library/Trial and /Library/Trial
# (and the boot job) even when the binary is already in place.
install_self() {
  local src dest
  src="$(script_self)"
  dest="${INSTALL_PATH}"

  if fapple_is_installed; then
    if update_installed_copy; then
      echo "already installed: ${dest}"
    else
      echo "already installed: ${dest} (script not rewritten; needs sudo to update)"
    fi
  else
    mkdir -p "$(dirname "${dest}")"
    if ! install -m 0755 "${src}" "${dest}" 2>/dev/null; then
      die "cannot write ${dest}; run: sudo $0 install"
    fi
    echo "installed ${dest}"
  fi
  occupy_defaults
  enable_auto_mount
}

print_one_status() {
  local title="$1"
  local image="$2"
  local mp="$3"
  local saved_mp saved_img
  saved_mp="${MOUNT_POINT}"
  saved_img="${IMAGE_PATH}"
  MOUNT_POINT="${mp}"
  IMAGE_PATH="${image}"
  echo "${title}"
  echo "  mount point:  ${mp}"
  echo "  image:        ${image}$([[ -f "${image}" ]] && echo " (exists)" || echo " (missing)")"
  echo "  mounted at:   $(mounted_at "${mp}" || echo "not mounted")"
  if [[ -n "$(mounted_at "${mp}")" ]]; then
    echo "  volume size:  $(volume_total_bytes || echo unknown) bytes"
    echo "  free space:   $(volume_free_bytes || echo unknown) bytes"
    if mounted_volume_is_1mb; then
      echo "  1 MB image:   yes"
    else
      echo "  1 MB image:   NO — this is the host disk; triald can write"
    fi
    if is_readonly_mount "${mp}"; then
      echo "  mount flags:  read-only"
    else
      echo "  mount flags:  read-write"
    fi
    if trial_is_writable; then
      echo "  writes:       OPEN — triald can write"
    else
      echo "  writes:       blocked"
    fi
  else
    echo "  volume size:  not mounted (host folder, not 1 MB)"
    echo "  writes:       OPEN — triald can write"
  fi
  MOUNT_POINT="${saved_mp}"
  IMAGE_PATH="${saved_img}"
}

print_status() {
  resolve_image_path
  echo "mode:         ${MODE}"
  echo "size:         1 MB (not 1 GB)"
  echo
  print_one_status "user triald (~/Library/Trial):" "${IMAGE_PATH}" "$(default_mount_point)"
  echo
  print_one_status "triald_system (/Library/Trial):" "${SYSTEM_IMAGE_PATH}" "${SYSTEM_MOUNT}"
  echo
  if [[ -f "${SYSTEM_LAUNCHD_PLIST}" ]] && auto_mount_loaded_system_label "${SYSTEM_LAUNCHD_LABEL}"; then
    echo "boot auto-mount:  enabled (${SYSTEM_LAUNCHD_PLIST})"
  elif [[ -f "${SYSTEM_LAUNCHD_PLIST}" ]]; then
    echo "boot auto-mount:  plist present but not loaded (${SYSTEM_LAUNCHD_PLIST})"
  else
    echo "boot auto-mount:  disabled"
  fi
  if auto_mount_loaded_user; then
    echo "login auto-mount: enabled ($(user_plist_path))"
  elif [[ -f "$(user_plist_path)" ]]; then
    echo "login auto-mount: plist present but not loaded ($(user_plist_path))"
  else
    echo "login auto-mount: disabled"
  fi
  echo
  diskutil list
}

run_for_mode() {
  local action="$1"
  shift || true
  if [[ "${MODE}" == "partition" ]]; then
    "${action}_partition" "$@"
  else
    "${action}_image" "$@"
  fi
}

# --- args ---
while [[ $# -gt 0 ]]; do
  case "$1" in
    -m|--mount-point)
      [[ $# -ge 2 ]] || die "--mount-point needs a path"
      CLI_MOUNT="$2"
      shift 2
      ;;
    --image)
      if [[ $# -ge 2 && "$2" != -* && "$2" != up && "$2" != create && "$2" != mount && "$2" != unmount && "$2" != umount && "$2" != destroy && "$2" != status && "$2" != help && "$2" != install && "$2" != automount && "$2" != enable-auto-mount && "$2" != disable-auto-mount ]]; then
        CLI_IMAGE="$2"
        shift 2
      else
        CLI_MODE="image"
        shift
      fi
      ;;
    --image-mode)
      CLI_MODE="image"
      shift
      ;;
    -p|--partition)
      [[ $# -ge 2 ]] || die "--partition needs a disk identifier (diskutil list)"
      CLI_MODE="partition"
      CLI_DISK="$2"
      shift 2
      ;;
    --yes)
      YES=1
      shift
      ;;
    --force)
      FORCE=1
      shift
      ;;
    up|create|mount|unmount|umount|destroy|status|help|install|automount|enable-auto-mount|disable-auto-mount)
      CMD="$1"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1 (try --help)"
      ;;
  esac
done

[[ "${CMD}" == "help" ]] && { usage; exit 0; }
[[ "${CMD}" == "umount" ]] && CMD="unmount"
[[ "${CMD}" == "install" ]] && { install_self; exit 0; }

assert_size_is_small
load_state
[[ -n "${CLI_MODE}" ]] && MODE="${CLI_MODE}"
[[ -n "${CLI_DISK}" ]] && PARTITION_DISK="${CLI_DISK}"
resolve_image_path

if [[ -n "${CLI_MOUNT}" ]]; then
  MOUNT_POINT="$(expand_user_path "${CLI_MOUNT}")"
elif [[ -z "${MOUNT_POINT}" || "${MOUNT_POINT}" == "/mnt/trialdisk" ]]; then
  MOUNT_POINT="$(default_mount_point)"
else
  MOUNT_POINT="$(expand_user_path "${MOUNT_POINT}")"
fi
safe_mount_point "${MOUNT_POINT}"

case "${CMD}" in
  create|destroy)
    if [[ "${MODE}" == "partition" ]]; then
      need_root "${CMD}"
    fi
    ;;
esac

case "${CMD}" in
  status)              print_status ;;
  automount)           run_for_mode mount 1 ;;
  enable-auto-mount)   enable_auto_mount ;;
  disable-auto-mount)  disable_auto_mount ;;
  create)
    if [[ -n "${CLI_MOUNT}" || -n "${CLI_IMAGE}" ]]; then
      run_for_mode create
    else
      resolve_image_path
      ensure_hfs_image "${IMAGE_PATH}" "${VOLUME_NAME}"
      if [[ ${EUID} -eq 0 ]]; then
        ensure_hfs_image "${SYSTEM_IMAGE_PATH}" "${SYSTEM_VOLUME_NAME}"
      fi
    fi
    ;;
  mount|up)
    if [[ -n "${CLI_MOUNT}" ]]; then
      run_for_mode create
      run_for_mode mount 0
    else
      occupy_defaults
    fi
    ;;
  unmount)
    if [[ -n "${CLI_MOUNT}" ]]; then
      run_for_mode unmount
    else
      IMAGE_PATH="$(pick_existing_image || true)"
      MOUNT_POINT="$(default_mount_point)"
      run_for_mode unmount
      if [[ ${EUID} -eq 0 ]]; then
        IMAGE_PATH="${SYSTEM_IMAGE_PATH}"
        MOUNT_POINT="${SYSTEM_MOUNT}"
        run_for_mode unmount
      fi
    fi
    ;;
  destroy)
    if [[ -n "${CLI_MOUNT}" ]]; then
      run_for_mode destroy
    else
      IMAGE_PATH="$(pick_existing_image || echo "${IMAGE_PATH}")"
      MOUNT_POINT="$(default_mount_point)"
      run_for_mode destroy
      if [[ ${EUID} -eq 0 ]]; then
        IMAGE_PATH="${SYSTEM_IMAGE_PATH}"
        MOUNT_POINT="${SYSTEM_MOUNT}"
        run_for_mode destroy
      fi
    fi
    ;;
  *)
    die "unknown command: ${CMD}"
    ;;
esac
