#!/usr/bin/env bash
# fapple — make Apple Trial dirs unwritable to triald / triald_system.
#
# The volume is 1 MB on purpose (never 1 GB) so it is easy to fill.
# That tiny disk is broken on purpose: filler.binary occupies every
# free byte, then the image is mounted read-only so triald cannot
# delete the filler and write again.
#
# User agent triald writes ~/Library/Trial. System daemon triald_system
# writes /Library/Trial. Both get a 1 MB read-only image. Do not try to
# disable the daemons — SIP / XPC will restart them. Kill processes that
# have files open under either Trial dir, remove those files, then mount
# before the daemons recreate anything.
set -euo pipefail

VOLUME_NAME="fapple"
LEGACY_VOLUME_NAME="trialdisk"
# 1 megabyte. Do not change this to 1g / 1GB.
SIZE="1m"
IMAGE_BYTES=1048576
IMAGE_FS="HFS+"
IMAGE_LAYOUT="NONE"
PARTITION_FS="MS-DOS"

STATE_DIR="/usr/local/var/fapple"
IMAGE_PATH="${STATE_DIR}/fapple.dmg"
STATE_FILE="${STATE_DIR}/state"
LEGACY_STATE_DIR="/usr/local/var/trialdisk"
LEGACY_IMAGE_PATH="${LEGACY_STATE_DIR}/trialdisk.dmg"

LAUNCHD_LABEL="local.fapple"
SYSTEM_LAUNCHD_LABEL="local.fapple.system"
LEGACY_LAUNCHD_LABEL="local.trialdisk"
LAUNCHD_PLIST="/Library/LaunchDaemons/${LAUNCHD_LABEL}.plist"
SYSTEM_LAUNCHD_PLIST="/Library/LaunchDaemons/${SYSTEM_LAUNCHD_LABEL}.plist"
SYSTEM_MOUNT="/Library/Trial"
SYSTEM_IMAGE_PATH="${STATE_DIR}/fapple-system.dmg"
SYSTEM_VOLUME_NAME="fapplesys"
USER_IMAGE_SUBDIR="Library/Application Support/fapple"
USER_IMAGE_NAME="fapple.dmg"
LEGACY_USER_IMAGE_SUBDIR="Library/Application Support/trialdisk"
LEGACY_USER_IMAGE_NAME="trialdisk.dmg"
INSTALL_PATH="/usr/local/bin/fapple"

MODE="image"
PARTITION_DISK=""
CMD="up"
YES=0
FORCE=0
CLI_MODE=""
CLI_MOUNT=""
CLI_DISK=""
CLI_IMAGE=""
MOUNT_POINT=""
DEVICE=""

usage() {
  cat <<'EOF'
fapple — make Trial dirs unwritable to triald / triald_system.

1 MB on purpose so the volume is easy to fill, then mount read-only
at ~/Library/Trial and (with sudo) /Library/Trial. Do not disable
the daemons; they will restart. Kill processes that have files open
in the Trial dirs, remove those files, then attach before they
create new ones.

Usage:
  sudo fapple [command] [options]

Commands:
  up                  Create 1 MB disks if needed, then occupy both Trial dirs
  create              Create the 1 MB disk(s) only
  mount               Kill holders of Trial files, empty the dirs, remount read-only
  unmount             Unmount (images stay on disk)
  destroy             Unmount and delete the images
  enable-auto-mount   Remount at login, and at boot for /Library/Trial if sudo
  disable-auto-mount  Remove the login/boot auto-mount jobs
  install             Install to /usr/local/bin and occupy both Trial dirs.
                      Re-run with sudo occupies both even if already installed
  status              Print current disk / mount info
  help                Show this help

Options:
  -m, --mount-point PATH   Mount directory (default: ~/Library/Trial)
      --image PATH         Disk image to use
      --image-mode         Use a disk image (default, safe)
  -p, --partition DISK     Real GPT partition on DISK (1 MB)
      --yes                Skip the physical-partition confirmation prompt
      --force              Allow targeting the boot disk (not recommended)

Examples:
  sudo fapple
  sudo fapple install
  sudo fapple mount
  sudo fapple status
EOF
}

die() { echo "error: $*" >&2; exit 1; }

script_self() {
  local dir base
  dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  base="$(basename "${BASH_SOURCE[0]}")"
  echo "${dir}/${base}"
}

xml_escape() {
  local s="$1"
  s="${s//&/&amp;}"
  s="${s//</&lt;}"
  s="${s//>/&gt;}"
  s="${s//\"/&quot;}"
  printf '%s' "${s}"
}

user_account() {
  # LaunchDaemons have no USER / SUDO_USER. Never expand unset USER
  # under `set -u` or the boot job dies and /Library/Trial stays on
  # the host disk (terabytes free for triald_system).
  if [[ ${EUID} -eq 0 && -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
    printf '%s' "${SUDO_USER}"
  elif [[ -n "${USER:-}" ]]; then
    printf '%s' "${USER}"
  else
    id -un
  fi
}

user_home() {
  local user home
  user="$(user_account)"
  home="$(dscl . -read "/Users/${user}" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
  [[ -n "${home}" ]] || die "cannot resolve home for ${user}"
  printf '%s' "${home}"
}

user_uid() {
  id -u "$(user_account)"
}

default_mount_point() {
  printf '%s/Library/Trial' "$(user_home)"
}

user_image_path() {
  printf '%s/%s/%s' "$(user_home)" "${USER_IMAGE_SUBDIR}" "${USER_IMAGE_NAME}"
}

legacy_user_image_path() {
  printf '%s/%s/%s' "$(user_home)" "${LEGACY_USER_IMAGE_SUBDIR}" "${LEGACY_USER_IMAGE_NAME}"
}

user_plist_path() {
  printf '%s/Library/LaunchAgents/%s.plist' "$(user_home)" "${LAUNCHD_LABEL}"
}

legacy_user_plist_path() {
  printf '%s/Library/LaunchAgents/%s.plist' "$(user_home)" "${LEGACY_LAUNCHD_LABEL}"
}

expand_user_path() {
  local path="$1"
  if [[ "${path}" == ~* ]]; then
    path="${path/#\~/$(user_home)}"
  fi
  printf '%s' "${path}"
}

need_root() {
  if [[ ${EUID} -ne 0 ]]; then
    die "run with sudo: sudo $(script_self) $*"
  fi
}

assert_size_is_small() {
  case "${SIZE}" in
    1m|1M|1mb|1MB) ;;
    *)
      die "fapple volume size must be 1 megabyte (got SIZE=${SIZE}). Refusing 1 GB or any other size"
      ;;
  esac
}

safe_mount_point() {
  local mp home=""
  mp="$1"
  home="$(user_home 2>/dev/null || true)"
  [[ "${mp}" == /* ]] || die "mount point must be an absolute path: ${mp}"
  case "${mp}" in
    /|"/Users"|"/Library"|"/Library/"|"/System"|"/System/"|"/System/Library"|"/System/Library/")
      die "refusing to use ${mp} as a mount point"
      ;;
  esac
  if [[ -n "${home}" ]]; then
    case "${mp}" in
      "${home}"|"${home}/Library"|"${home}/Library/")
        die "refusing to use ${mp} as a mount point"
        ;;
    esac
  fi
}

installed_fapple() {
  if [[ -x "${INSTALL_PATH}" ]]; then
    printf '%s' "${INSTALL_PATH}"
  else
    script_self
  fi
}

load_state() {
  local f
  for f in "${STATE_FILE}" "${LEGACY_STATE_DIR}/state"; do
    [[ -r "${f}" ]] || continue
    # shellcheck disable=SC1090
    source "${f}" 2>/dev/null || true
    return 0
  done
}

save_state() {
  mkdir -p "${STATE_DIR}" 2>/dev/null || return 0
  [[ -w "${STATE_DIR}" ]] || return 0
  cat > "${STATE_FILE}" <<EOF
MODE='${MODE}'
MOUNT_POINT='${MOUNT_POINT}'
IMAGE_PATH='${IMAGE_PATH}'
PARTITION_DISK='${PARTITION_DISK}'
DEVICE='${DEVICE:-}'
VOLUME_NAME='${VOLUME_NAME}'
EOF
  chmod 600 "${STATE_FILE}" 2>/dev/null || true
}

pick_existing_image() {
  local candidate
  for candidate in \
    "${CLI_IMAGE}" \
    "${IMAGE_PATH}" \
    "${STATE_DIR}/fapple.dmg" \
    "${LEGACY_IMAGE_PATH}" \
    "$(user_image_path)" \
    "$(legacy_user_image_path)"
  do
    [[ -n "${candidate}" && -f "${candidate}" ]] || continue
    printf '%s' "${candidate}"
    return 0
  done
  return 1
}

resolve_image_path() {
  local existing
  if [[ -n "${CLI_IMAGE}" ]]; then
    IMAGE_PATH="$(expand_user_path "${CLI_IMAGE}")"
    return 0
  fi
  if existing="$(pick_existing_image)"; then
    IMAGE_PATH="${existing}"
    return 0
  fi
  if [[ ${EUID} -eq 0 ]]; then
    IMAGE_PATH="${STATE_DIR}/fapple.dmg"
  else
    IMAGE_PATH="$(user_image_path)"
  fi
}

image_is_hfs() {
  local path="${1:-${IMAGE_PATH}}"
  [[ -f "${path}" ]] || return 1
  hdiutil imageinfo "${path}" 2>/dev/null | grep -qiE 'HFS|Apple_HFS'
}

volume_device() {
  local name dev
  for name in "${VOLUME_NAME}" "${LEGACY_VOLUME_NAME}"; do
    dev="$(diskutil info "${name}" 2>/dev/null | awk -F': *' '/Device Node/ {print $2; exit}' || true)"
    if [[ -n "${dev}" ]]; then
      printf '%s' "${dev}"
      return 0
    fi
  done
  return 1
}

mounted_at() {
  mount | awk -v mp="$1" '$3 == mp {print $1; exit}'
}

image_attached_dev() {
  hdiutil info 2>/dev/null | awk -v img="${IMAGE_PATH}" '
    $0 ~ img {found=1}
    found && /\/dev\/disk[0-9]+/ {print $1; exit}
  ' || true
}

boot_whole_disk() {
  diskutil info / 2>/dev/null | awk -F': *' '/Part of Whole/ {print $2; exit}'
}

is_boot_target() {
  local target="$1"
  local boot
  boot="$(boot_whole_disk)"
  [[ -n "${boot}" ]] || return 1
  [[ "${target}" == "${boot}" || "${target}" == "${boot}"s* ]]
}

detach_image() {
  local dev
  dev="$(image_attached_dev)"
  if [[ -n "${dev}" ]]; then
    echo "detaching ${IMAGE_PATH} (${dev})"
    hdiutil detach "${dev}" -quiet || hdiutil detach "${dev}" -force -quiet || true
  fi
  if [[ -n "$(mounted_at "${MOUNT_POINT}")" ]]; then
    diskutil unmount force "${MOUNT_POINT}" >/dev/null 2>&1 || true
  fi
}

unlock_host_dir() {
  local mp="${1:-${MOUNT_POINT}}"
  mkdir -p "${mp}"
  chmod u+rwx "${mp}" 2>/dev/null || chmod 0755 "${mp}" 2>/dev/null || true
  chflags nouchg,noschg "${mp}" 2>/dev/null || true
}

# If the image is not covering Trial, stop triald from using the host folder.
lock_host_dir() {
  local mp="${1:-${MOUNT_POINT}}"
  [[ -d "${mp}" ]] || return 0
  [[ -z "$(mounted_at "${mp}")" ]] || return 0
  chmod 000 "${mp}" 2>/dev/null || true
}

dir_has_children() {
  [[ -n "$(find "$1" -mindepth 1 -maxdepth 1 2>/dev/null | head -n 1)" ]]
}

# PIDs with an open FD under mp. find always emits mp itself so xargs
# never runs lsof with no arguments (which would list every process).
open_holders() {
  local mp="$1"
  local pid
  [[ -d "${mp}" ]] || return 0
  while IFS= read -r pid; do
    [[ "${pid}" =~ ^[0-9]+$ ]] || continue
    [[ "${pid}" != "$$" && "${pid}" != "${PPID}" ]] || continue
    (( pid > 1 )) || continue
    printf '%s\n' "${pid}"
  done < <(find "${mp}" -print0 2>/dev/null | xargs -0 lsof -t 2>/dev/null | sort -u)
}

# Drop FDs so Trial files can be removed. triald / triald_system will
# restart (SIP / XPC); that is expected.
kill_open_holders() {
  local mp="$1"
  local sig="${2:-TERM}"
  local pid comm
  while IFS= read -r pid; do
    [[ -n "${pid}" ]] || continue
    comm="$(ps -p "${pid}" -o comm= 2>/dev/null || true)"
    comm="${comm##*/}"
    case "${comm}" in
      launchd|kernel_task) continue ;;
    esac
    echo "killing ${comm:-pid} (${pid}) holding files in ${mp} (SIG${sig})"
    kill -"${sig}" "${pid}" 2>/dev/null || true
  done < <(open_holders "${mp}")
}

delete_contents() {
  local mp="$1"
  local f
  while IFS= read -r f; do
    [[ -e "${f}" || -L "${f}" ]] || continue
    chflags nouchg,noschg "${f}" 2>/dev/null || true
    /bin/rm -rf "${f}" 2>/dev/null || true
  done < <(find "${mp}" -depth -mindepth 1 2>/dev/null || true)
}

empty_mount_dir() {
  local mp="$1"
  local i
  local home=""
  home="$(user_home 2>/dev/null || true)"
  safe_mount_point "${mp}"
  if [[ -n "$(mounted_at "${mp}")" ]]; then
    die "cannot empty ${mp}: still mounted"
  fi
  unlock_host_dir "${mp}"
  if [[ ${EUID} -eq 0 && -n "${home}" && "${mp}" == "${home}"/* ]]; then
    chown "$(user_account):staff" "${mp}" 2>/dev/null \
      || chown "$(user_account)" "${mp}" 2>/dev/null \
      || true
  fi
  echo "killing processes with open files in ${mp}"
  for i in 1 2 3; do
    dir_has_children "${mp}" || return 0
    kill_open_holders "${mp}" TERM
    sleep 0.3
    echo "deleting files in ${mp}"
    delete_contents "${mp}"
  done
  if dir_has_children "${mp}"; then
    echo "retrying with SIGKILL for remaining holders in ${mp}"
    kill_open_holders "${mp}" KILL
    sleep 0.3
    delete_contents "${mp}"
  fi
  if dir_has_children "${mp}"; then
    lock_host_dir "${mp}"
    die "mount point ${mp} is not empty (files still open)"
  fi
}

volume_free_bytes() {
  df -b "${MOUNT_POINT}" 2>/dev/null | awk 'NR==2 {print $4 * 512; exit}'
}

volume_total_bytes() {
  df -b "${MOUNT_POINT}" 2>/dev/null | awk 'NR==2 {print $2 * 512; exit}'
}

image_file_bytes() {
  stat -f%z "$1" 2>/dev/null || echo 0
}

# dmg file and mounted volume must be 1 MB, never the host APFS disk.
image_is_1mb() {
  local sz
  [[ -f "$1" ]] || return 1
  sz="$(image_file_bytes "$1")"
  [[ "${sz}" -gt 0 && "${sz}" -le ${IMAGE_BYTES} ]]
}

mounted_volume_is_1mb() {
  local total
  total="$(volume_total_bytes || echo 0)"
  [[ -n "${total}" && "${total}" -gt 0 && "${total}" -le ${IMAGE_BYTES} ]]
}

is_readonly_mount() {
  mount | awk -v mp="$1" '$3 == mp && $0 ~ /read-only/ {found=1} END {exit !found}'
}

trial_is_writable() {
  local probe="${MOUNT_POINT}/.fapple-write-probe"
  if ( : > "${probe}" ) 2>/dev/null; then
    /bin/rm -f "${probe}" 2>/dev/null || true
    return 0
  fi
  return 1
}

harden_image_file() {
  [[ -f "${IMAGE_PATH}" ]] || return 0
  chflags nouchg "${IMAGE_PATH}" 2>/dev/null || true
  chmod a-w "${IMAGE_PATH}" 2>/dev/null || true
  chflags uchg "${IMAGE_PATH}" 2>/dev/null || true
}

attach_image() {
  local readonly="$1"
  local -a args
  args=(attach "${IMAGE_PATH}" -mountpoint "${MOUNT_POINT}" -nobrowse)
  if [[ "${readonly}" == "1" ]]; then
    args+=(-readonly)
  fi
  hdiutil "${args[@]}"
}

# Fill until ENOSPC when the volume is writable. dd bs=4096 leaves up
# to one allocation-block of slack — follow with 512 then 1-byte pads
# so a RW remount still cannot create files. Then the image is mounted
# read-only so triald cannot delete the filler.
fill_volume() {
  local dest free i
  dest="${MOUNT_POINT}/filler.binary"
  trial_is_writable || {
    echo "Trial is not writable"
    return 0
  }
  free="$(volume_free_bytes || echo 0)"
  [[ -n "${free}" && "${free}" -gt 0 ]] || return 0
  echo "filling ${MOUNT_POINT} so a RW remount would still be full"
  dd if=/dev/zero of="${dest}" bs=4096 conv=notrunc 2>/dev/null || true
  dd if=/dev/zero of="${MOUNT_POINT}/filler.512" bs=512 conv=notrunc 2>/dev/null || true
  i=0
  while trial_is_writable && [[ ${i} -lt 64 ]]; do
    dd if=/dev/zero of="${MOUNT_POINT}/filler.pad.${i}" bs=1 count=512 2>/dev/null || break
    i=$((i + 1))
  done
  chflags uchg "${dest}" "${MOUNT_POINT}/filler.512" "${MOUNT_POINT}"/filler.pad.* 2>/dev/null || true
  free="$(volume_free_bytes || echo 0)"
  echo "filled ${MOUNT_POINT}; free space: ${free} bytes"
}

verify_unwritable() {
  if trial_is_writable; then
    die "${MOUNT_POINT} is still writable; triald would not be blocked"
  fi
  if is_readonly_mount "${MOUNT_POINT}"; then
    echo "Trial is unwritable (read-only mount); triald is blocked"
  else
    echo "Trial is unwritable; triald is blocked"
  fi
}

report_mount() {
  local free total
  free="$(volume_free_bytes || echo unknown)"
  total="$(volume_total_bytes || echo unknown)"
  echo "mounted ${VOLUME_NAME} at ${MOUNT_POINT}"
  echo "volume size: ${total} bytes"
  echo "free space: ${free} bytes"
  if ! mounted_volume_is_1mb; then
    die "${MOUNT_POINT} is ${total} bytes, not the 1 MB image — triald would write to the host disk"
  fi
  verify_unwritable
}

trial_already_blocked() {
  [[ -n "$(mounted_at "${MOUNT_POINT}")" ]] || return 1
  is_readonly_mount "${MOUNT_POINT}" || return 1
  trial_is_writable && return 1
  mounted_volume_is_1mb || return 1
  return 0
}

ensure_hfs_image() {
  local path="$1"
  local vol="$2"
  local sz
  assert_size_is_small
  if [[ -f "${path}" ]] && image_is_hfs "${path}" && image_is_1mb "${path}"; then
    echo "1 MB disk already exists: ${path}"
    return 0
  fi
  if [[ -f "${path}" ]]; then
    sz="$(image_file_bytes "${path}")"
    echo "replacing image ${path} (${sz} bytes, must be 1 MB HFS+)"
    chflags nouchg "${path}" 2>/dev/null || true
    chmod u+w "${path}" 2>/dev/null || true
    rm -f "${path}"
  fi
  mkdir -p "$(dirname "${path}")"
  echo "creating 1 MB HFS+ image ${path} (volume ${vol})"
  hdiutil create \
    -size "${SIZE}" \
    -layout "${IMAGE_LAYOUT}" \
    -fs "${IMAGE_FS}" \
    -volname "${vol}" \
    -ov \
    "${path}" >/dev/null
  sz="$(image_file_bytes "${path}")"
  if [[ "${sz}" -gt ${IMAGE_BYTES} ]]; then
    rm -f "${path}"
    die "hdiutil created a ${sz} byte image at ${path}; refusing anything over 1 MB"
  fi
  echo "created ${path} (${sz} bytes)"
}

create_image() {
  ensure_hfs_image "${IMAGE_PATH}" "${VOLUME_NAME}"
  save_state
}

occupy_target() {
  local image="$1"
  local mp="$2"
  local vol="$3"
  CLI_IMAGE="${image}"
  CLI_MOUNT="${mp}"
  IMAGE_PATH="${image}"
  MOUNT_POINT="${mp}"
  VOLUME_NAME="${vol}"
  safe_mount_point "${MOUNT_POINT}"
  ensure_hfs_image "${IMAGE_PATH}" "${VOLUME_NAME}"
  mount_image
}

occupy_user_trial() {
  resolve_image_path
  occupy_target "${IMAGE_PATH}" "$(default_mount_point)" "${VOLUME_NAME:-fapple}"
}

occupy_system_trial() {
  need_root "mount /Library/Trial"
  occupy_target "${SYSTEM_IMAGE_PATH}" "${SYSTEM_MOUNT}" "${SYSTEM_VOLUME_NAME}"
}

occupy_defaults() {
  occupy_user_trial
  if [[ ${EUID} -eq 0 ]]; then
    occupy_system_trial
  else
    echo "skipping ${SYSTEM_MOUNT} (needs sudo); user Trial is occupied"
  fi
}

mount_image() {
  local skip_empty="${1:-0}"
  local attach_out
  resolve_image_path
  [[ -f "${IMAGE_PATH}" ]] || die "no 1 MB disk at ${IMAGE_PATH}; run: sudo $0 create"
  if trial_already_blocked; then
    echo "already blocking triald at ${MOUNT_POINT} (read-only)"
    DEVICE="$(mounted_at "${MOUNT_POINT}")"
    save_state
    return 0
  fi
  detach_image
  empty_mount_dir "${MOUNT_POINT}"
  if [[ -w "${IMAGE_PATH}" ]]; then
    echo "attaching ${IMAGE_PATH} read-write to fill it"
    if ! attach_out="$(attach_image 0 2>&1)"; then
      echo "${attach_out}" >&2
    else
      echo "${attach_out}"
      fill_volume
      detach_image
      empty_mount_dir "${MOUNT_POINT}"
    fi
    harden_image_file
  fi
  echo "attaching ${IMAGE_PATH} read-only at ${MOUNT_POINT}"
  if ! attach_out="$(attach_image 1 2>&1)"; then
    echo "${attach_out}" >&2
    lock_host_dir "${MOUNT_POINT}"
    if [[ "${attach_out}" == *"no mountable file systems"* ]]; then
      die "attach failed at ${MOUNT_POINT}. MS-DOS/FAT will not mount on ~/Library; recreate as HFS+"
    fi
    die "hdiutil attach failed"
  fi
  echo "${attach_out}"
  DEVICE="$(awk '/\/dev\/disk[0-9]+/ {print $1; exit}' <<<"${attach_out}")"
  save_state
  report_mount
}

unmount_image() {
  if [[ -n "$(mounted_at "${MOUNT_POINT}")" ]]; then
    echo "unmounting ${MOUNT_POINT}"
    hdiutil detach "${MOUNT_POINT}" -quiet \
      || diskutil unmount force "${MOUNT_POINT}" >/dev/null
  else
    detach_image
    echo "not mounted"
  fi
  lock_host_dir
}

destroy_image() {
  unmount_image
  if [[ -f "${IMAGE_PATH}" ]]; then
    chflags nouchg "${IMAGE_PATH}" 2>/dev/null || true
    chmod u+w "${IMAGE_PATH}" 2>/dev/null || true
    rm -f "${IMAGE_PATH}"
    echo "deleted ${IMAGE_PATH}"
  fi
  unlock_host_dir
  rmdir "${MOUNT_POINT}" 2>/dev/null || true
  rm -f "${STATE_FILE}"
  if [[ -f "${LAUNCHD_PLIST}" ]] || auto_mount_loaded_system || auto_mount_loaded_user || [[ -f "$(user_plist_path)" ]]; then
    disable_auto_mount
  fi
}

create_partition() {
  assert_size_is_small
  local existing
  existing="$(volume_device || true)"
  if [[ -n "${existing}" ]]; then
    DEVICE="${existing}"
    echo "1 MB partition already exists: ${DEVICE}"
    save_state
    return 0
  fi
  [[ -n "${PARTITION_DISK}" ]] || die "pass --partition DISK (see diskutil list)"
  diskutil info "${PARTITION_DISK}" >/dev/null 2>&1 \
    || die "no such disk: ${PARTITION_DISK}"

  if is_boot_target "${PARTITION_DISK}" && [[ ${FORCE} -ne 1 ]]; then
    die "${PARTITION_DISK} is the boot disk. This Mac has no spare GPT space (APFS fills disk0). Use the default image mode, pick an external disk, or pass --force if you really intend to target it"
  fi

  echo "target disk:"
  diskutil list "${PARTITION_DISK}"
  if [[ ${YES} -ne 1 ]]; then
    read -r -p "Create a 1 MB MS-DOS partition named ${VOLUME_NAME} after ${PARTITION_DISK}? [y/N] " ans
    [[ "${ans}" == "y" || "${ans}" == "Y" ]] || die "aborted"
  fi

  echo "adding 1 MB ${PARTITION_FS} partition named ${VOLUME_NAME}"
  diskutil addPartition "${PARTITION_DISK}" "${PARTITION_FS}" "${VOLUME_NAME}" "${SIZE}"
  DEVICE="$(volume_device)"
  [[ -n "${DEVICE}" ]] || die "partition created but volume ${VOLUME_NAME} was not found"
  save_state
  echo "created ${DEVICE}"
}

mount_partition() {
  local skip_empty="${1:-0}"
  local dev
  dev="${DEVICE:-$(volume_device || true)}"
  [[ -n "${dev}" ]] || die "no ${VOLUME_NAME} volume found; run create first"
  if trial_already_blocked; then
    echo "already blocking triald at ${MOUNT_POINT} (read-only)"
    return 0
  fi
  if [[ -n "$(mounted_at "${MOUNT_POINT}")" ]]; then
    diskutil unmount force "${MOUNT_POINT}" >/dev/null 2>&1 || true
  fi
  if diskutil info "${dev}" 2>/dev/null | grep -q "Mount Point: */Volumes/"; then
    diskutil unmount "${dev}" >/dev/null
  fi
  empty_mount_dir "${MOUNT_POINT}"
  echo "mounting ${dev} read-only at ${MOUNT_POINT}"
  diskutil mount readOnly nobrowse -mountPoint "${MOUNT_POINT}" "${dev}"
  DEVICE="${dev}"
  fill_volume
  save_state
  report_mount
}

unmount_partition() {
  if [[ -n "$(mounted_at "${MOUNT_POINT}")" ]]; then
    echo "unmounting ${MOUNT_POINT}"
    diskutil unmount force "${MOUNT_POINT}" >/dev/null
  elif [[ -n "${DEVICE:-}" ]]; then
    diskutil unmount force "${DEVICE}" >/dev/null 2>&1 || true
  else
    echo "not mounted"
  fi
  lock_host_dir
}

destroy_partition() {
  unmount_partition
  local dev
  dev="${DEVICE:-$(volume_device || true)}"
  if [[ -n "${dev}" ]]; then
    echo "converting ${dev} back to free space"
    diskutil eraseVolume free none "${dev}"
  fi
  rmdir "${MOUNT_POINT}" 2>/dev/null || true
  rm -f "${STATE_FILE}"
}

auto_mount_loaded_system() {
  launchctl print "system/${SYSTEM_LAUNCHD_LABEL}" >/dev/null 2>&1 \
    || launchctl print "system/${LAUNCHD_LABEL}" >/dev/null 2>&1
}

auto_mount_loaded_system_label() {
  launchctl print "system/$1" >/dev/null 2>&1
}

auto_mount_loaded_user() {
  launchctl print "gui/$(user_uid)/${LAUNCHD_LABEL}" >/dev/null 2>&1
}

write_launchd_plist() {
  local dest label image mp self
  dest="$1"
  label="$2"
  image="$3"
  mp="$4"
  self="$(xml_escape "$(installed_fapple)")"
  image="$(xml_escape "${image}")"
  mp="$(xml_escape "${mp}")"
  mkdir -p "$(dirname "${dest}")" "${STATE_DIR}"
  cat > "${dest}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${label}</string>
  <key>Disabled</key>
  <false/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>${self}</string>
    <string>automount</string>
    <string>--image</string>
    <string>${image}</string>
    <string>--mount-point</string>
    <string>${mp}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>${STATE_DIR}/${label}.out.log</string>
  <key>StandardErrorPath</key>
  <string>${STATE_DIR}/${label}.err.log</string>
</dict>
</plist>
EOF
  chmod 644 "${dest}"
}

