  image="$(xml_escape "$(user_image_path)")"
  mp="$(xml_escape "${MOUNT_POINT}")"
  logdir="$(xml_escape "$(user_home)/Library/Logs")"
  mkdir -p "$(dirname "${plist}")" "$(user_home)/Library/Logs"
  cat > "${plist}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
